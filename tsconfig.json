{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "**/*.ts",
    "tests/performance/config/config.js",
    "tests/performance/utils/http-client.js",
    "tests/performance/services/auth.service.js",
    "tests/performance/scenarios/login.scenario.js"
  ],
  "exclude": ["node_modules", "dist"]
}
